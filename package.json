{
  "name": "umkm-sanggrahan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "cek:tipe": "next typegen && tsc --noEmit",
    "cek:kisi": "node scripts/cek-kisi.mjs",
    "cek:kontras": "node scripts/cek-kontras.mjs",
    "umkm:baru": "node scripts/tambah-umkm.mjs",
    "umkm:dari-banner": "node scripts/dari-banner.mjs",
    "umkm:cek": "node scripts/cek-data.mjs",
    "uji:panel": "node uji/panel.mjs",
    "qc": "npm run cek:tipe && npm run lint && npm run cek:kisi && npm run cek:kontras && npm run build && npm run cek:halaman && npm run umkm:cek",
    "cek:halaman": "node scripts/cek-halaman.mjs",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^6.19.3",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "description": "Etalase online UMKM warga Desa Sanggrahan RW 1 dan RW 3",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
