# PostgreSQL. Di lingkungan demo memakai Neon (neon.tech).
# Basis data ini terpisah dari basis data Profil RW Sanggrahan.
# Contoh: postgresql://pengguna:sandi@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://pengguna:sandi@host/nama_basis_data?sslmode=require"

# Kunci penanda tangan sesi. Wajib diganti, minimal 32 karakter.
SESSION_SECRET="ubah-ini-dengan-string-acak-minimal-32-karakter"

# Opsional. Bila diisi, unggahan foto disimpan ke Vercel Blob.
# Bila dikosongkan, unggahan ditulis ke folder public/unggahan.
BLOB_READ_WRITE_TOKEN=""

# Akun pengelola pertama, dipakai sekali saat "npm run db:seed".
SEED_ADMIN_EMAIL="admin@sanggrahan.id"
SEED_ADMIN_SANDI="ubah-sandi-ini"
